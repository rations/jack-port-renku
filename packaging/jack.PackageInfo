name			jack
version			1.9.23-9
architecture	x86_64
summary			"JACK2 low-latency audio server (RenkuOS)"
description		"A native RenkuOS port of JACK2 (jackd2), the low-latency audio server,
with a Media Kit based backend. Includes the jackd server, libjack/libjackserver,
the dummy/haiku/hmulti audio backends and the haikumidi MIDI slave, and the standard
JACK example tools. Kasen and the rest of the RenkuOS audio stack can run
on it."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2001-2024 Paul Davis, Stephane Letz and the JACK developers"
}
licenses {
	"GNU GPL v2"
	"GNU LGPL v2.1"
}
provides {
	jack = 1.9.23
	cmd:jackd = 1.9.23
	lib:libjack = 1.9.23
	lib:libjackserver = 1.9.23
	devel:libjack = 1.9.23
}
requires {
	haiku
	lib:libopus
	lib:libsamplerate
}
urls {
	"https://github.com/rations/jack-port-renku"
}
